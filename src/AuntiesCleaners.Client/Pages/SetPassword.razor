@page "/set-password"
@using AuntiesCleaners.Client.Services
@inject ISupabaseClientService Supabase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 80vh;">
    <MudPaper Elevation="3" Class="pa-8 mx-auto" Style="width: 100%; max-width: 400px;">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" Color="Color.Primary">Auntie's Cleaners</MudText>
            <MudText Typo="Typo.h6">Set Your Password</MudText>

            @if (_expired)
            {
                <MudAlert Severity="Severity.Warning">
                    This invite link has expired. Please contact your administrator for a new invite.
                </MudAlert>
            }
            else if (_success)
            {
                <MudAlert Severity="Severity.Success">
                    Password set successfully. You can now sign in.
                </MudAlert>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="false" Class="mt-2">
                    <MudText Typo="Typo.subtitle2">Bookmark this app URL for easy access:</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight: bold; word-break: break-all;">
                        https://jedmcdaniel253.github.io/AuntiesCleaners/
                    </MudText>
                </MudAlert>

                <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true" Class="mt-1" Icon="@Icons.Material.Filled.PhoneIphone">
                    <MudText Typo="Typo.caption">
                        On mobile? Tap the share icon and select "Add to Home Screen" for easy access.
                    </MudText>
                </MudAlert>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateToRoute("login"))">
                    Go to Sign In
                </MudButton>
            }
            else if (_ready)
            {
                <MudTextField @bind-Value="_password"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              FullWidth="true" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Confirm Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              FullWidth="true" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_isLoading"
                           OnClick="HandleSetPassword">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Set Password
                </MudButton>
            }
            else
            {
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Verifying invite link...</MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isLoading;
    private bool _expired;
    private bool _success;
    private bool _ready;

    // Static fields survive component re-creation from layout re-renders
    private static string? s_accessToken;
    private static string? s_refreshToken;
    private static bool s_tokensExtracted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // If tokens were already extracted (component was re-created by layout re-render), reuse them
        if (s_tokensExtracted)
        {
            _ready = !string.IsNullOrEmpty(s_accessToken);
            _expired = !_ready;
            StateHasChanged();
            return;
        }

        try
        {
            var hash = await JS.InvokeAsync<string>("eval", "window.location.hash.substring(1)");

            if (string.IsNullOrEmpty(hash))
            {
                _expired = true;
                StateHasChanged();
                return;
            }

            var parameters = System.Web.HttpUtility.ParseQueryString(hash);
            s_accessToken = parameters["access_token"] ?? "";
            s_refreshToken = parameters["refresh_token"] ?? "";
            var tokenType = parameters["type"] ?? "";
            s_tokensExtracted = true;

            if (string.IsNullOrEmpty(s_accessToken) || tokenType != "recovery")
            {
                _expired = true;
                StateHasChanged();
                return;
            }

            _ready = true;
        }
        catch
        {
            _expired = true;
        }

        StateHasChanged();
    }

    private async Task HandleSetPassword()
    {
        _errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
        {
            _errorMessage = "Password must be at least 6 characters.";
            return;
        }

        if (_password != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        _isLoading = true;
        try
        {
            await Supabase.Client.Auth.SetSession(s_accessToken!, s_refreshToken!);
            await Supabase.Client.Auth.Update(new Supabase.Gotrue.UserAttributes { Password = _password });
            _success = true;

            // Clear static tokens after successful use
            s_accessToken = null;
            s_refreshToken = null;
            s_tokensExtracted = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to set password. The link may have expired. ({ex.Message})";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
